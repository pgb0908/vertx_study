{
  "apiVersion": "iip.gateway/v1alpha1",
  "kind": "Connector",
  "uid": "echo-connector-uid",
  "workspaceId": "dev",
  "id": "echo-connector",
  "name": "echo-connector",
  "version": "v1",
  "description": "local dummy upstream on port 9001",
  "metadata": {
    "name": "echo-connector"
  },
  "spec": {
    "protocol": "HTTP",
    "proxyPath": "/echo",
    "method": "POST",
    "loadBalancing": {
      "algorithm": "ROUND_ROBIN",
      "targets": [
        { "host": "localhost", "port": 9001, "weight": 1 }
      ]
    },
    "retry": {
      "numRetries": 2
    },
    "circuitBreaker": {
      "failureThreshold": 2,
      "resetTimeout": 3000
    },
    "timeout": {
      "read": 5000
    }
  }
}
